# Public build uses no official backend when these are empty.
# All WXT_ values are bundled into the extension. Never put privileged credentials here.
WXT_BH_SUPABASE_URL=
WXT_BH_SUPABASE_PUBLISHABLE_KEY=
# Optional: origin of YOUR checkout website (HTTPS only); empty disables external messaging.
WXT_BH_CHECKOUT_ORIGIN=
